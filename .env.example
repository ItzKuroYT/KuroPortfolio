# Vercel only. Never put these values in js/config.js.
STRIPE_SECRET_KEY=
# OPTIONAL: true only after configuring separate Stripe Tax settings.
# Donations use standard Checkout; Stripe Managed Payments does not support cash donations.
STRIPE_AUTOMATIC_TAX=false
DISCORD_ORDER_WEBHOOK_URL=
ORDER_ADMIN_KEY=
# Full frontend base URL, including GitHub repository subpath, ending in /.
FRONTEND_URL=https://kuro.iconrealms.net/
# Origins only, comma separated; no paths and no trailing slash..
ALLOWED_ORIGINS=https://kuro.iconrealms.net,https://kuroportfolio.vercel.app
# OPTIONAL: leave both empty to store orders in the private Discord channel.
# Redis provides shared rate limits, caching, and atomic order decisions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
